---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Home">
    <header class="hero">
        <div class="hero-content">
            <p>Hello world! Here's a future engineer</p>
            <h1>I'm Eugenia Ramirez <br>Systems Engineer</h1>
            
            <div class="tags">
                <span class="tag">[ Python / Pandas ]</span>
                <span class="tag">[ Linux / Proxmox ]</span>
                <span class="tag">[ Lua / LÖVE2D ]</span>
                <span class="tag">[ Databases ]</span>
            </div>

            <div class="cta-buttons">
                <a href="#projects" class="btn primary">[ View Projects 📁 ]</a>
                <a href="/Cv_Eugenia_Ramirez.pdf" target="_blank" class="btn secondary">[ Download CV 📄 ]</a>
            </div>
        </div>
    </header>

    <section id="projects" class="projects-grid">
        <a href="/proyectos/dspace" class="card systems-card">
            <div class="card-header">01 // INFRASTRUCTURE 🗄️</div>
            <h2>DSpace 9.x Core Migration</h2>
            <p>Data migration and architecture upgrade protocol (6.x to 9.x) for the university's institutional repository.</p>
            <div class="card-tags"><span>[Solr]</span><span>[DSpace]</span><span>[Linux]</span><span>[Bash]</span></div>
        </a>

        <a href="/proyectos/proxmox" class="card systems-card">
            <div class="card-header">02 // INFRASTRUCTURE 🗄️</div>
            <h2>Server Administration</h2>
            <p>Virtualization management, Proxmox deployment, ZFS file systems, and Nginx reverse proxies.</p>
            <div class="card-tags"><span>[Proxmox]</span><span>[ZFS]</span><span>[Nginx]</span></div>
        </a>

        <a href="/proyectos/huellasacasa" class="card dev-card">
            <div class="card-header">03 // CREATIVE DEV ⚔️</div>
            <h2>Paws to Home</h2>
            <p>2D platformer video game built with Lua and LÖVE2D featuring custom collision physics.</p>
            <div class="card-tags"><span>[Lua]</span><span>[LÖVE2D]</span></div>
        </a>
    </section>

    <section id="about-me" class="about-section">
        <div class="card about-card">
            <div class="about-content">
                <h2>~/About_me</h2>
                <p>I am a Systems Engineering student at Universidad de Los Andes and IT Support Assistant at DTES. I specialize in building and administering IT infrastructure (Linux, Proxmox, ZFS) to ensure service availability while developing software architectures.</p>
                <div class="social-links">
                    <a href="https://github.com/eunight" target="_blank" class="btn secondary">[ GitHub ]</a>
                    <a href="https://www.linkedin.com/in/eunight" target="_blank" class="btn secondary">[ LinkedIn ]</a>
                </div>
            </div>
        </div>
    </section>
</Layout>